{
  "manifest_version": 3,
  "name": "Chaturbate Model Lock \u2014 Overlay Bridge",
  "version": "1.1.2",
  "description": "Lock a Chaturbate room and best-effort detect explicit tip notices from the room page for local OBS overlays.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chaturbate.com/*",
    "https://www.chaturbate.com/*",
    "http://127.0.0.1:8788/*"
  ],
  "action": {
    "default_title": "Chaturbate Model Lock",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chaturbate.com/*",
        "https://www.chaturbate.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
